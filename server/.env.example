PORT=3000
DB_URL=mongodb://127.0.0.1:27017/workshop
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Chatbot (OpenAI-compatible endpoint — OpenCode Zen, OpenRouter, etc.)
CHATBOT_API_BASE=https://opencode.ai/zen/v1
CHATBOT_API_KEY=replace-with-your-real-api-key
CHATBOT_MODEL=mimo-v2.5-free
CHATBOT_TYPING_DELAY_MS=1000

# Optional: overrides the bot's default system prompt
# CHATBOT_SYSTEM_PROMPT=You are a helpful teaching assistant.

# VERCEL is set automatically by Vercel — do not set it locally.

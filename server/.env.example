PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_FILES=10

# ---------------------------------------------------------------------------
# STORAGE_DRIVER = local | cloudinary | s3      (default: local)
# The local driver needs NO extra packages and NO keys. Start here.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local

# --- Cloudinary (only if STORAGE_DRIVER=cloudinary) -------------------------
# npm install cloudinary multer-storage-cloudinary
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_key
# CLOUDINARY_API_SECRET=your_secret
# CLOUDINARY_FOLDER=s17-collage

# --- Amazon S3 (only if STORAGE_DRIVER=s3) ----------------------------------
# npm install @aws-sdk/client-s3 multer-s3
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# S3_BUCKET=s17-photo-collage
